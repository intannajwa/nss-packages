#!/bin/sh /etc/rc.common
# NSS Driver IRQ Balancing Script - Auto USB IRQ Detection Version

START=94
PROG="qca-nss-drv"

# Get CPU info
TOTAL_CPUS=$(grep -c ^processor /proc/cpuinfo)
[ "$TOTAL_CPUS" -lt 4 ] && CPU_LIST="0-$((TOTAL_CPUS-1))" || CPU_LIST="0-$((TOTAL_CPUS-1))"

CPU_RANGE=""
for i in $(seq 1 $((TOTAL_CPUS - 1))); do
    CPU_RANGE="$CPU_RANGE,$i"
done
CPU_RANGE="${CPU_RANGE#,}"

log_msg() {
    logger -t "$PROG" "Pinning IRQ($4) $1 to CPU $2"
}

cpus_to_bitmask() {
    local bitmask=0
    for cpu in ${*//,/ }; do
        bitmask=$((bitmask | (1 << cpu)))
    done
    printf '%x' $bitmask
}

set_affinity() {
    local irq_name="$1" affinity="$2" occurrence="${3:-1}"
    awk -v irq_name="$irq_name" -v occurrence="$occurrence" '
        BEGIN{count=0}
        $NF==irq_name {
            if(++count==occurrence){
                sub(/:$/,"",$1)
                print $1
            }
    }' /proc/interrupts | while read -r irq; do
        bitmask=$(cpus_to_bitmask "$affinity")
        echo "$bitmask" > /proc/irq/"$irq"/smp_affinity 2>/dev/null && \
        $enable_log && log_msg "$irq_name" "$affinity" "$occurrence" "$irq"
    done
}

balance_interrupts() {
    logger -t "$PROG" "Optimizing IRQ balancing"
 
    set_affinity "nss_queue0" "1,2,3" 1
    set_affinity "nss_queue0" "1,2,3" 2
    set_affinity "nss_queue1" "0,2,3" 1
    set_affinity "nss_queue2" "0,1,3" 1
    set_affinity "nss_queue3" "0,1,2" 1

    set_affinity "nss_empty_buf_sos" "1,2,3" 1
    set_affinity "nss_empty_buf_queue" "1,2,3" 1
    set_affinity "nss_empty_buf_sos" "1,2,3" 2
 
    for irq_name in $(awk '{print $NF}' /proc/interrupts | grep -E '^xhci[-_]hcd:usb[0-9]+$'); do
        set_affinity "$irq_name" "$CPU_RANGE" 1
    done
}

optimize_rps() {
    NEW_MASK="e"  # 0xE = CPUs 1,2,3

    for netdev in /sys/class/net/*; do
        [ -d "$netdev" ] || continue
        devname=$(basename "$netdev")
        case "$devname" in
            lo|br-*) continue ;;
        esac
        
        for queue in "$netdev"/queues/rx-*; do
            [ -f "$queue/rps_cpus" ] || continue
            echo "$NEW_MASK" > "$queue/rps_cpus" 2>/dev/null && \
            logger -t "$PROG" "RPS set to CPUs 1-3 for $devname"
        done
    done
}

start() {
    config_load nss
    config_get_bool enable_log "general" enable_log 1
    [ "$enable_log" -eq 1 ] && enable_log=true || enable_log=false

    balance_interrupts
    optimize_rps
 
    sysctl -w net.core.netdev_max_backlog=30000 >/dev/null
    sysctl -w net.core.somaxconn=4096 >/dev/null
    sysctl -w net.ipv4.tcp_tw_reuse=1 >/dev/null
 
    echo "$(cpus_to_bitmask "1,2,3")" > /proc/irq/default_smp_affinity 2>/dev/null
}

stop() { :; }
restart() { stop; start; }
